{
    "manifest_version": 3,
    "name": "shopping-cart",
    "version": "1.0.0",
    "description": "Keep track of your purchases!",
   
    "permissions": [
        "storage",
        "tabs"
      ],
    
      "host_permissions": [
        "https://www.amazon.ca/*",
        "https://www.amazon.com/*"
      ],
    
      "content_scripts": [
        {
          "matches": [
            "https://www.amazon.ca/*",
            "https://www.amazon.com/*",
            "http://localhost:5174/*",
            "http://localhost:5173/*",
            "http://127.0.0.1:5000/*"
          ],
          "js": ["content.js"],
          "run_at": "document_idle"
        }
    ],
    "action": {
        "default_popup": "popup.html"
      }
  }